{
  "name": "@luka-cat-mimi/n8n-nodes-authing-admin",
  "version": "2.0.12",
  "description": "Authing Admin N8N 凭证插件",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "authing",
    "authing-admin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-authing-admin#readme",
  "author": {
    "name": "domi-lucky",
    "email": "dengxiaomei714@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-authing-admin.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "format": "prettier credentials nodes --write",
    "lint": "n8n-node lint",
    "prepublishOnly": "n8n-node prerelease",
    "build:watch": "tsc --watch",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AuthingAdminApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AuthingAdmin/AuthingAdmin.node.js"
    ],
    "strict": false
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.19.43",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}

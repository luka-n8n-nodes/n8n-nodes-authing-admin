{
    "name": "@luka-cat-mimi/n8n-nodes-authing-admin",
    "version": "2.0.10",
    "description": "Authing Admin N8N 凭证插件",
    "keywords": [
        "n8n",
        "n8n-node",
        "n8n-community-node-package",
        "authing",
        "authing-admin"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-authing-admin#readme",
    "author": {
        "name": "domi-lucky",
        "email": "dengxiaomei714@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-authing-admin.git"
    },
    "engines": {
        "node": ">=20.15"
    },
    "main": "index.js",
    "scripts": {
        "build": "n8n-node build",
        "dev": "n8n-node dev",
        "format": "prettier credentials nodes --write",
        "lint": "n8n-node lint",
        "lintfix": "n8n-node lint --fix",
        "prepublishOnly": "npm run build && npm run lint"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/AuthingAdminApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/AuthingAdmin/AuthingAdmin.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.23.1",
        "@types/node": "^20.19.37",
        "eslint": "9.39.4",
        "prettier": "3.8.1",
        "release-it": "^19.0.4",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "glob": "^10.4.5"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
